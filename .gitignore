# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep the committed template: it documents the required vars and holds
# no secrets (everything in it is NEXT_PUBLIC_* and therefore public anyway).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
dev.log
